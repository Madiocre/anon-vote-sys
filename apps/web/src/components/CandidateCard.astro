---
import type { Candidate } from "@avs/shared";

interface Props {
  /**
   * Widened with an optional `description` so the detail panel is wired up
   * before the column exists. When `Candidate` gains the field in
   * @avs/shared, this starts rendering with no change here or in index.astro.
   */
  candidate: Candidate & { description?: string };
  /** The first row is above the fold on most screens; the rest can load lazily. */
  eager?: boolean;
}

const { candidate, eager = false } = Astro.props;

// The submit handler on index.astro mints a fresh token on demand and sends it
// in the JSON body, so no token ever has to live inside this form.
---

<li class="card" data-candidate-card>
  <div class="card__media">
    <img
      data-candidate-image
      src={candidate.imageUrl}
      alt=""
      width="800"
      height="800"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : "auto"}
    />

    {/*
      Rendered only when there is something to show, so the dwell does not
      reveal an empty panel while the field is still absent. The card still
      scales on dwell either way.
    */}
    {candidate.description && <p class="card__details">{candidate.description}</p>}
  </div>

  <div class="card__body">
    <h2 class="card__name" id={`name-${candidate.id}`}>{candidate.name}</h2>

    <form method="POST" action="/api/vote" class="vote-form" data-vote-form>
      <input type="hidden" name="candidateId" value={candidate.id} />
      <button type="submit" class="btn" data-vote-button>
        Vote<span class="visually-hidden"> for {candidate.name}</span>
      </button>
    </form>
  </div>
</li>
