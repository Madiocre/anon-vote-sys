---
import type { Candidate } from "@avs/shared";

interface Props {
  candidate: Candidate;
  /** The first row is above the fold on most screens; the rest can load lazily. */
  eager?: boolean;
}

const { candidate, eager = false } = Astro.props;

// No Turnstile widget in this component, deliberately. There is exactly ONE for
// the whole page (see index.astro) — rendering one per card meant twenty widgets
// on a twenty-candidate ballot: visually awful, and twenty challenge instances
// for a page where at most one vote is ever cast.
//
// The submit handler on index.astro mints a fresh token on demand and sends it
// in the JSON body, so no token ever has to live inside this form.
//
// (Comments live here rather than in the markup on purpose: HTML comments in an
// .astro template are emitted to the browser, frontmatter comments are not.)
---

<li class="card">
  <div class="card__media">
    <img
      src={candidate.imageUrl}
      alt=""
      width="800"
      height="800"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : "auto"}
    />
  </div>

  <div class="card__body">
    <h2 class="card__name" id={`name-${candidate.id}`}>{candidate.name}</h2>

    <form method="POST" action="/api/vote" class="vote-form" data-vote-form>
      <input type="hidden" name="candidateId" value={candidate.id} />
      <button type="submit" class="btn" data-vote-button>
        Vote<span class="visually-hidden"> for {candidate.name}</span>
      </button>
    </form>
  </div>
</li>
