---
import { getCachedCandidates } from "../server/lib/cache.ts";
import { getVoterStatus, readVotedCandidateId, resolveIdentity } from "../server/lib/identity.ts";
import { ROUTES } from "@avs/shared";

import Layout from "../layouts/Layout.astro";
import VoteConfirmation from "../components/VoteConfirmation.astro";
import { cfContext, env } from "../lib/runtime.ts";

export const prerender = false;

const ctx = cfContext(Astro.locals);

// The signed vote cookie is the cheap path and answers most visits with zero D1
// reads. But it is not the only way index.astro decides someone has voted, and
// when the two disagreed this page contradicted the redirect that sent the
// visitor here — "we don't see a vote from this browser", immediately after
// being refused the ballot. That is what a voter whose vote cookie expired, or
// was partially cleared, would see.
//
// So: fall back to the same check the ballot uses. Only on a cookie miss, so
// the common case still costs nothing.
let votedFor = await readVotedCandidateId(Astro.request, env);

if (!votedFor) {
  const identity = await resolveIdentity(Astro.request, env);
  const status = await getVoterStatus(Astro.request, env, identity);
  votedFor = status.candidateId;
}

let candidate = null;
if (votedFor) {
  const { value: candidates } = await getCachedCandidates(env, ctx);
  candidate = candidates.find((entry) => entry.id === votedFor) ?? null;
}

Astro.response.headers.set("cache-control", "no-store");
---

<Layout title="Thank you for participating" noIndex>
  {
    candidate ? (
      /* Same component the ballot reveals inline on a successful vote, so both
         paths look identical. See components/VoteConfirmation.astro. */
      <VoteConfirmation candidate={candidate} />
    ) : (
      <Fragment>
        <header class="page-header">
          <h1>Thank you for participating</h1>
          {votedFor ? (
            <p>Your vote has been recorded.</p>
          ) : (
            <p>
              We don't see a vote from this browser. If you haven't voted yet, the ballot is
              still open.
            </p>
          )}
        </header>

        <p class="footer-links">
          <a class="btn btn--inline" href={ROUTES.results}>View the results</a>
          {!votedFor && <a class="btn btn--ghost btn--inline" href={ROUTES.vote}>Go to the ballot</a>}
        </p>
      </Fragment>
    )
  }
</Layout>
