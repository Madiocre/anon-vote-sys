---
import { getCachedCandidates } from "../server/lib/cache.ts";
import { readVotedCandidateId } from "../server/lib/identity.ts";
import { ROUTES } from "@avs/shared";

import Layout from "../layouts/Layout.astro";
import { cfContext, env } from "../lib/runtime.ts";

export const prerender = false;

const ctx = cfContext(Astro.locals);

// Cookie-only read: this page costs zero D1 queries beyond the cached candidate list.
const votedFor = await readVotedCandidateId(Astro.request, env);

let candidate = null;
if (votedFor) {
  const { value: candidates } = await getCachedCandidates(env, ctx);
  candidate = candidates.find((entry) => entry.id === votedFor) ?? null;
}

Astro.response.headers.set("cache-control", "no-store");
---

<Layout title="Thank you for participating" noIndex>
  <header class="page-header">
    <h1>Thank you for participating</h1>
    {
      candidate ? (
        <p>Your vote for <strong>{candidate.name}</strong> has been recorded.</p>
      ) : votedFor ? (
        <p>Your vote has been recorded.</p>
      ) : (
        <p>
          We don't see a vote from this browser. If you haven't voted yet, the ballot is
          still open.
        </p>
      )
    }
  </header>

  {
    candidate && (
      <div class="receipt">
        <div class="receipt__media">
          <img src={candidate.imageUrl} alt="" width="800" height="800" decoding="async" />
        </div>
        <p class="receipt__name">{candidate.name}</p>
        <p class="receipt__meta">Counted · one vote per person</p>
      </div>
    )
  }

  <p class="page-header" style="margin-top: var(--space-8)">
    Results refresh every few minutes, so your vote may take a moment to show up in the
    totals.
  </p>

  <p class="footer-links">
    <a class="btn btn--inline" href={ROUTES.results}>View the results</a>
    {!votedFor && <a class="btn btn--ghost btn--inline" href={ROUTES.vote}>Go to the ballot</a>}
  </p>
</Layout>

<style>
  .receipt {
    width: min(100%, 320px);
    margin: 0 auto;
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .receipt__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }

  .receipt__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .receipt__name {
    margin: var(--space-4) 0 var(--space-1);
    font-size: 1.1rem;
    font-weight: 640;
  }

  .receipt__meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
