{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    // The base sets `["bun"]`, which is right for packages/db's seed scripts but
    // wrong here — this code runs on workerd, not Bun. The Worker globals
    // (D1Database, DurableObjectNamespace, RateLimit, Cache) come from
    // worker-configuration.d.ts, generated by `bun run types`.
    "types": []
  },
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  // Tests need the Bun globals this project deliberately keeps out of Worker
  // code, so they are typechecked by tsconfig.test.json instead. `bun run
  // typecheck` runs both — neither half is skipped.
  "exclude": [
    "dist",
    "**/*.test.ts",
    "src/server/test-helpers.ts",
    "src/server/db-mock.ts"
  ]
}
